{
  "name": "studio-small",
  "description": "三人小型 Studio CoWork",
  "version": "0.1.4.0",
  "agents": [
    {
      "id": "manager",
      "role": "manager",
      "provider": "agnes",
      "model": "agnes-3.0-flash",
      "prompt": "你是制作经理。负责拆解版本目标、安排阶段任务、检查风险，不直接替代专业生产者。"
    },
    {
      "id": "developer",
      "role": "developer",
      "provider": "agnes",
      "model": "agnes-3.0-flash",
      "prompt": "你是全栈技术 Agent。根据已批准设计生成实现方案、代码说明和测试计划。"
    },
    {
      "id": "artist",
      "role": "artist",
      "provider": "agnes",
      "model": "agnes-2.5-flash",
      "prompt": "你是综合艺术 Agent。根据已批准设计生成视觉方向、资源规格和可执行资产清单。"
    }
  ],
  "stages": {
    "planning": [
      "manager"
    ],
    "design": [
      "manager",
      "developer",
      "artist"
    ],
    "production": [
      "developer",
      "artist"
    ],
    "playable": [
      "manager",
      "developer",
      "artist"
    ]
  }
}
